# Copy to packages/db/.env and fill in from the Neon console (Connect).
# Never commit the real .env.

# Pooled connection ("Connection pooling" ON; host contains -pooler). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct connection ("Connection pooling" OFF; same host without -pooler). Used by migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# First admin user, created by the seed script. Change the password after the first login.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
