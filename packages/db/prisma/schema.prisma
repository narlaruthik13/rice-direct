// Kisa database schema (Neon PostgreSQL).
// DATABASE_URL: pooled connection (PgBouncer), used by the app at runtime.
// DIRECT_URL:   direct connection, used by Prisma Migrate (migrations need a session, not a pool).
//
// Business model: Kisa is a rice-only brand. Partner mills pack rice in Kisa-branded
// bags; Kisa sells to customers (mill → Kisa → customer). Mills are recorded for
// payouts and quality, and are never shown publicly. No farmers.
//
// Conventions
// - Money is integer paise (₹62 = 6200). No floats for money; matches Razorpay.
// - Weights are whole kg (every pack size is whole kg).
// - Category-specific fields (rice: riceType, age) live in Batch.attributes and are
//   validated per category in @kisa/shared, so new categories need no schema change.
// - CHECK constraints that Prisma cannot express live in the migration SQL:
//     Batch: 0 <= availableKg <= packedKg; packedDate >= millingDate; bestBefore > packedDate
//     Product.pricePaise = millPricePaise + kisaMarginPaise
//     Order.totalPaise = millTotalPaise + kisaMarginTotalPaise + deliveryFeePaise

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum OrderStatus {
  PLACED
  PAID
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum AdminRole {
  ADMIN
  STAFF
}

enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  REACTIVATE
  STOCK_ADJUST
}

enum StockAdjustmentReason {
  DAMAGED
  RECOUNT
  RETURNED
  OTHER
}

// ---------- Catalogue ----------

/// A product line, e.g. rice. Only "rice" is active today; dal or millets can be added
/// as rows (plus their attribute rules in @kisa/shared) without a schema change.
model Category {
  id            String   @id // "rice"
  name          String
  slug          String   @unique
  packSizesKg   Int[]
  /// Default best-before: packed date + this many days.
  shelfLifeDays Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  varieties Variety[]
  batches   Batch[]
}

/// Admin-managed list of varieties per category, e.g. Sona Masoori, BPT 5204, HMT.
model Variety {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  slug       String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  batches  Batch[]

  @@unique([categoryId, name])
}

/// A partner mill that packs rice in Kisa bags. Never shown to customers.
model Mill {
  id             String   @id @default(cuid())
  name           String
  contactName    String?
  phone          String?  @unique
  town           String
  district       String
  state          String
  fssaiLicense   String?
  certifications String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batches Batch[]
}

/// One lot packed by one mill. Printed on the bag + QR → /trace/[batchId] (the Quality Passport).
model Batch {
  id          String   @id // KS-YYYY-MMDD-XX, e.g. KS-2026-0412-SM
  categoryId  String
  varietyId   String
  millId      String
  millingDate DateTime @db.Date
  packedDate  DateTime @db.Date
  /// Not sold from this date on.
  bestBefore  DateTime @db.Date
  /// Kg packed in Kisa bags.
  packedKg    Int
  /// Stock left to sell, kg. Reduced when an order is paid. CHECK 0..packedKg.
  availableKg Int
  /// Category-specific fields, e.g. rice { riceType: "RAW" | "STEAM" | "BOILED", age: "NEW" | "AGED" }.
  attributes  Json
  /// Category-specific quality report (RiceQuality in @kisa/shared).
  quality     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id])
  variety          Variety           @relation(fields: [varietyId], references: [id])
  mill             Mill              @relation(fields: [millId], references: [id])
  products         Product[]
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]

  @@index([categoryId, packedDate])
  @@index([varietyId])
  @@index([millId])
}

/// A pack of one batch, e.g. 10 kg of KS-2026-0412-SM. Prices are per pack.
model Product {
  id              String   @id @default(cuid())
  slug            String   @unique // URL: /product/[slug]
  name            String
  batchId         String
  bagSizeKg       Int
  /// Paid to the mill per pack. Never shown publicly.
  millPricePaise  Int
  /// Kisa's margin per pack. Never shown publicly.
  kisaMarginPaise Int
  /// Always mill price + Kisa margin (CHECK constraint). The only price customers see.
  pricePaise      Int
  description     String
  tags            String[]
  featured        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batch      Batch       @relation(fields: [batchId], references: [id])
  orderItems OrderItem[]

  @@index([batchId])
}

// ---------- Customers and orders ----------

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Order {
  id         String      @id @default(cuid())
  code       String      @unique // shown to the customer
  customerId String
  status     OrderStatus @default(PLACED)

  // Delivery address (snapshot). Hyderabad only: pincode must be serviceable.
  addressName  String
  addressPhone String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String

  deliveryDate    DateTime @db.Date
  deliverySlotId  String
  deliveryAgentId String?
  /// Customer OTP that confirms delivery (hashed, never stored in plain text).
  deliveryOtpHash String?

  paymentMethod String

  // Totals (paise): sums of the item snapshots, plus delivery.
  millTotalPaise       Int
  kisaMarginTotalPaise Int
  deliveryFeePaise     Int @default(0)
  totalPaise           Int

  paidAt       DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now()) // placed at
  updatedAt    DateTime  @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  deliverySlot  DeliverySlot   @relation(fields: [deliverySlotId], references: [id])
  deliveryAgent DeliveryAgent? @relation(fields: [deliveryAgentId], references: [id])
  items         OrderItem[]
  events        OrderEvent[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([deliveryDate, deliverySlotId])
}

/// One line of an order. Snapshots the mill and the price split, so weekly mill payouts
/// never depend on today's catalogue.
model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  productId       String
  batchId         String
  millId          String
  productName     String
  bagSizeKg       Int
  quantity        Int
  // Per pack, at the time of ordering (paise).
  unitPricePaise  Int
  millPricePaise  Int
  kisaMarginPaise Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])

  @@index([orderId])
  @@index([batchId])
  @@index([millId])
}

/// Status history: every transition, who made it and why.
model OrderEvent {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  adminUserId String?
  createdAt   DateTime     @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([orderId, createdAt])
}

// ---------- Delivery (Hyderabad only) ----------

model ServiceablePincode {
  pincode   String   @id
  area      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A daily delivery window, e.g. 07:00–10:00. Capacity = max orders per day in this slot.
model DeliverySlot {
  id        String   @id @default(cuid())
  label     String
  startTime String // "07:00" (Asia/Kolkata)
  endTime   String // "10:00"
  capacity  Int
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model DeliveryAgent {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// ---------- Admin ----------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orderEvents      OrderEvent[]
  sessions         AdminSession[]
  auditLogs        AdminAuditLog[]
  stockAdjustments StockAdjustment[]
}

/// One login on one device. Holds a hash of the current refresh token; each refresh
/// rotates it (the old session is revoked and points to its replacement).
model AdminSession {
  id               String    @id // also the "sid" claim in the tokens
  adminUserId      String
  /// SHA-256 of the refresh token. The token itself is never stored.
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Set on rotation: the session that replaced this one.
  replacedById     String?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

/// Every admin change: who changed what, and the changed fields as { field: { before, after } }.
model AdminAuditLog {
  id          String      @id @default(cuid())
  adminUserId String
  /// "Mill", "Variety", "Batch" or "Product".
  entity      String
  entityId    String
  action      AuditAction
  changes     Json
  createdAt   DateTime    @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([adminUserId])
}

/// A manual stock correction on a batch (orders reduce stock separately). CHECK deltaKg <> 0.
model StockAdjustment {
  id              String                @id @default(cuid())
  batchId         String
  adminUserId     String
  /// Signed: negative removes stock (e.g. damaged), positive adds it (e.g. returned).
  deltaKg         Int
  reason          StockAdjustmentReason
  note            String?
  availableBefore Int
  availableAfter  Int
  createdAt       DateTime              @default(now())

  batch     Batch     @relation(fields: [batchId], references: [id])
  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([batchId, createdAt])
}
