# Copy to apps/web/.env.local. All server-only: never prefix with NEXT_PUBLIC_.

# Where catalogue data comes from: "mock" (data/api-snapshot.json, the default) or "api".
# Production (Vercel) stays on mock until the API is deployed: don't set "api" there yet.
DATA_SOURCE="mock"

# The Kisa API, used when DATA_SOURCE="api" (server to server; the browser never calls it).
API_URL="http://localhost:4000"

# Shared with apps/admin: the admin sends it to POST /api/revalidate after catalogue changes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=""
