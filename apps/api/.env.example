# Copy to apps/api/.env. Never commit the real .env.

# Neon pooled connection (host contains -pooler); same value as packages/db/.env.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Two different random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters"

# Comma-separated browser origins allowed to call the API (web, admin).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Optional
# PORT=4000
# NODE_ENV=development
# JWT_ACCESS_TTL_SECONDS=900   # access token lifetime (5-3600); tests use a few seconds
# LOGIN_RATE_LIMIT_PER_MINUTE=5  # login attempts per minute per IP
