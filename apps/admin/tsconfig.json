{
  "extends": "@kisa/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "target": "ES2017",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-verify/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e/.results",
    "playwright-report"
  ]
}
