# Copy to apps/admin/.env.local. Server-only: never prefix with NEXT_PUBLIC_.
# Where the admin's server reaches the Kisa API (server to server; the browser never calls it).
API_URL="http://localhost:4000"

# The public website, for trace links, the QR codes printed on labels, and cache refreshes (server-only).
WEB_URL="http://localhost:3000"

# Same value as apps/web's REVALIDATE_SECRET: after catalogue changes the admin's server calls
# {WEB_URL}/api/revalidate with it, so the website updates at once (otherwise within 5 minutes).
REVALIDATE_SECRET=""
