{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["NEXT_DIST_DIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@kisa/admin#test:e2e": {
      "dependsOn": ["build", "^build", "@kisa/api#build"],
      "cache": false
    },
    "@kisa/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env.local"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@kisa/web#test:e2e": {
      "dependsOn": ["^build", "@kisa/api#build", "@kisa/admin#build"],
      "cache": false
    }
  }
}
